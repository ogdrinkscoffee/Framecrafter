# ---------------------------------------------------------------------------
# Framecraft server environment — copy to .env and fill in real values.
# Never commit .env (the repo ignores `.env*`; only this example is tracked).
#
# Rule: every value below is read by the Node/Express server only, unless the
# name starts with VITE_. Vite inlines VITE_* variables into the browser
# bundle, so a secret must never carry that prefix.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# Port for `npm run dev` / `npm run start` (defaults to 3000)
PORT=3000
# Canonical app origin used for OAuth callbacks and redirect checks
APP_URL=http://localhost:3000

# --- AI Co-Pilot (server-side only) ---------------------------------------
# Used by POST /api/ai/edit-element. Never expose this to the client.
GEMINI_API_KEY=

# --- GitHub OAuth App (server-side) ---------------------------------------
# PKCE S256 is the default flow; GITHUB_CLIENT_SECRET is only used by legacy
# non-PKCE exchanges and must stay server-side.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional custom callback URL (defaults to <origin>/auth/github/callback)
GITHUB_OAUTH_CALLBACK_URL=

# --- Bot protection (Cloudflare Turnstile) --------------------------------
# Both keys enable captcha + honeypot checks on public AI submissions. The
# site key is public (served by GET /api/security/status); the secret key is
# server-side only. Leave both empty to disable bot protection locally.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Public (non-secret) --------------------------------------------------
# Optional extra origin allowed to receive the OAuth popup postMessage
# handshake. This is a public origin, not a credential, hence the VITE_ prefix.
VITE_GITHUB_OAUTH_CALLBACK_URL=

# --- Optional server fallback ---------------------------------------------
# Read/write GitHub token used only when no OAuth/PAT session is present.
# Leave empty unless you need it for local automation.
GITHUB_TOKEN=
